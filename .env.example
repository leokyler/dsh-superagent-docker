# Copy to .env and adjust. `docker compose` reads it automatically.

# Host port opened in the browser. Must equal the DSH webserver port inside the
# container (3082), because the management API checks the Host header's port.
SUPERAGENT_PORT=3082

# Host folder bind-mounted at /home/node/src: local clones and ticket worktrees.
# On Docker Desktop for Windows, use a path WSL can see, e.g. /home/you/src/agent-repos
SUPERAGENT_REPOS=./repos

# 1 = restart the service when `status` reports exit 1 (not running).
SUPERAGENT_SUPERVISE=1

# Packages to install when the container starts, for a repository whose
# toolchain the image does not ship. Space or comma separated.
# SUPERAGENT_APT_PACKAGES="golang-go default-jdk"
SUPERAGENT_APT_PACKAGES=

# Baked into the image so the entrypoint knows whether the packages above are
# already installed. CI sets it to the commit; a local build can leave it alone.
SUPERAGENT_IMAGE_REVISION=local
